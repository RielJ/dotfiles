{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": "."
	},
	"include": ["**/*.ts"],
	"exclude": ["**/*.off/**", "git/**", "**/node_modules/**"]
}
