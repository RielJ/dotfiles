{
  "lastChangelogVersion": "1.0.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "compaction": {
    "reserveTokens": 20000,
    "modelOverrides": {
      "anthropic/claude-opus-5-5": {
        "keepRecentTokens": 30000
      }
    }
  },
  "superpowers": {
    "enabled": {
      "planner": true,
      "web-search": true,
      "dual-review": true,
      "qmd": true
    }
  },
  "theme": "dark-classic",
  "tuiMode": "regular",
  "usage": {
    "plan": "max20x"
  },
  "packages": [
    "npm:pi-token-burden",
    "npm:pi-promptsmith",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-skills-sh",
    "npm:pi-skill-toggle",
    "npm:@sting8k/pi-vcc",
    "npm:@tomooshi/condensed-milk-pi",
    "npm:@tomooshi/caveman-milk-pi",
    "npm:pi-mcp-adapter",
    "npm:@ogulcancelik/pi-minimal-footer",
    "npm:@ff-labs/pi-fff",
    "npm:@tmustier/pi-tab-status",
    "npm:pi-bash-bg",
    "npm:pi-tool-display",
    "npm:pi-vim",
    "npm:@bytesbrains/pi-textbrowser",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-lens",
    "npm:@ayulab/pi-rewind",
    "npm:@llblab/pi-telegram",
    "npm:@vigolium/piolium",
    "../../personal/contribs/pi-agent-browser-native"
  ],
  "extensions": [
    "-builtin:mcp"
  ]
}
